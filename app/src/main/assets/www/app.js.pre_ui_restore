  function templateSheet(){const ds=dayState();openSheet('Choose Today Template',`<div class="stack"><button class="btn ${ds.template==='home'?'primary':''}" data-template="home">Home Day</button><button class="btn ${ds.template==='out'?'primary':''}" data-template="out">Going Out Day</button><div class="help">Changing template does not erase your tasks, money or thesis data.</div></div>`);$$('[data-template]').forEach(b=>b.onclick=()=>{ds.template=b.dataset.template;state.settings.dayTemplate=b.dataset.template;save();closeSheet();renderToday();});}
