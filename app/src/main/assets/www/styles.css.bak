:root{--bg:#f6f8f7;--card:#fff;--text:#17221d;--muted:#6c7771;--line:#e4e9e6;--accent:#2f7a5c;--accent2:#e8f3ed;--danger:#b64f4f;--warn:#a76a19;--blue:#466fa7;--purple:#775ca8;--shadow:0 8px 24px rgba(22,45,33,.07);--radius:18px;--nav-h:74px;color-scheme:light}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;overflow-x:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.app-shell{min-height:100vh;max-width:760px;margin:0 auto;background:var(--bg);padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 18px)}
.topbar{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:calc(10px + env(safe-area-inset-top)) 16px 10px;background:rgba(246,248,247,.95);backdrop-filter:blur(12px);border-bottom:1px solid rgba(228,233,230,.85)}.brand{font-weight:800;font-size:16px;display:flex;align-items:center;gap:8px}.brand-mark{color:var(--accent);font-size:14px}.tagline{font-size:11px;color:var(--muted);margin-top:2px}.icon-btn{width:44px;height:44px;border:0;border-radius:14px;background:var(--card);color:var(--text);box-shadow:var(--shadow)}.profile-btn{font-weight:800;color:var(--accent)}
.view{padding:12px 14px 24px}.page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin:6px 2px 12px}.page-head h1{font-size:26px;margin:0}.page-head p{margin:2px 0 0;color:var(--muted);font-size:13px}.date-chip{font-size:12px;background:var(--card);border:1px solid var(--line);padding:8px 10px;border-radius:12px;white-space:nowrap}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px;margin-bottom:12px;box-shadow:var(--shadow)}.card.compact{padding:12px}.card-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}.card-head h2,.card-head h3{margin:0;font-size:16px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:800}.subtle{color:var(--muted);font-size:12px}.big-value{font-size:28px;font-weight:900;letter-spacing:-.03em}.title-rank{font-size:22px;font-weight:900;text-transform:uppercase}.row{display:flex;align-items:center;gap:10px}.row.between{justify-content:space-between}.stack{display:grid;gap:8px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.chip-row{display:flex;gap:8px;overflow-x:auto;padding:2px 0 4px;scrollbar-width:none}.chip-row::-webkit-scrollbar{display:none}.chip{border:1px solid var(--line);background:var(--card);padding:9px 12px;border-radius:999px;font-size:12px;white-space:nowrap;color:var(--text)}.chip.active{background:var(--accent2);border-color:#cfe3d6;color:var(--accent);font-weight:800}.pill{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;font-size:11px;background:#f0f3f1;color:var(--muted);font-weight:700}.pill.good{background:#e8f4ec;color:#2f7a5c}.pill.warn{background:#fff2dd;color:#8b5c1f}.pill.bad{background:#fde8e8;color:#a24444}.pill.blue{background:#e9f0fb;color:#466fa7}.pill.purple{background:#efeafb;color:#7058a0}
.progress{height:10px;background:#edf0ee;border-radius:999px;overflow:hidden}.progress>span{display:block;height:100%;background:var(--accent);border-radius:999px}.progress.small{height:7px}.progress-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:6px}.level-card{background:linear-gradient(145deg,#fdfefd,#edf5f0);border-color:#d7e5dc}.level-top{display:flex;justify-content:space-between;align-items:flex-start}.level-btn{border:0;background:transparent;text-align:left;padding:0;color:inherit}.level-btn:focus-visible{outline:2px solid var(--accent);outline-offset:4px;border-radius:8px}
.list{display:grid;gap:4px}.list-row{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);min-width:0}.list-row:last-child{border-bottom:0}.check{width:28px;height:28px;border-radius:50%;border:2px solid #cbd3ce;background:#fff;display:grid;place-items:center;font-size:13px;flex:0 0 auto}.check.done{background:var(--accent);border-color:var(--accent);color:#fff}.check.missed{background:#fdeaea;border-color:#e2aaaa;color:var(--danger)}.check.skip{background:#fff4e5;border-color:#e5c79a;color:var(--warn)}.row-title{font-weight:750;font-size:14px;overflow-wrap:anywhere}.row-sub{color:var(--muted);font-size:11px;margin-top:2px}.time{font-size:12px;font-weight:800;white-space:nowrap}.actions{display:flex;gap:6px;flex-wrap:wrap}.btn{min-height:42px;border:1px solid var(--line);background:var(--card);border-radius:12px;padding:9px 12px;color:var(--text);font-weight:750;font-size:13px}.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.btn.soft{background:var(--accent2);color:var(--accent);border-color:#d4e5da}.btn.danger{background:#fff3f3;color:var(--danger);border-color:#f0d0d0}.btn.small{min-height:34px;padding:6px 9px;font-size:11px;border-radius:10px}.btn.full{width:100%}.mini-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.status-dot{width:8px;height:8px;border-radius:50%;background:#c6cdca}.status-dot.good{background:#4a9a72}.status-dot.warn{background:#d89b43}.status-dot.bad{background:#c95d5d}.status-dot.blue{background:#5b84bd}
.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.quick{border:1px solid var(--line);background:#fafcfb;border-radius:14px;padding:11px 6px;text-align:center;font-size:11px;font-weight:750;min-height:66px}.quick span{display:block;font-size:20px;margin-bottom:4px}.interruption{border-color:#efd1a0;background:#fffaf2}.interruption .card-head{margin-bottom:6px}
.bottom-nav{position:fixed;z-index:30;left:50%;transform:translateX(-50%);bottom:0;width:min(100%,760px);height:calc(var(--nav-h) + env(safe-area-inset-bottom));padding:8px 10px calc(8px + env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(4,1fr);gap:4px;background:rgba(255,255,255,.96);backdrop-filter:blur(14px);border-top:1px solid var(--line)}.nav-item{border:0;background:transparent;border-radius:14px;color:var(--muted);display:grid;place-items:center;gap:1px;min-height:52px}.nav-item span{font-size:21px}.nav-item small{font-size:10px;font-weight:750}.nav-item.active{background:var(--accent2);color:var(--accent)}.fab{position:fixed;z-index:31;right:max(18px,calc((100vw - 760px)/2 + 18px));bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 14px);width:54px;height:54px;border-radius:18px;border:0;background:var(--accent);color:#fff;font-size:28px;box-shadow:0 12px 28px rgba(47,122,92,.28)}
.backdrop{position:fixed;inset:0;background:rgba(12,18,15,.38);z-index:80}.sheet{position:fixed;z-index:81;left:50%;transform:translateX(-50%);bottom:0;width:min(100%,760px);max-height:86vh;overflow:auto;background:var(--card);border-radius:24px 24px 0 0;padding:10px 16px calc(22px + env(safe-area-inset-bottom));box-shadow:0 -20px 50px rgba(0,0,0,.14)}.sheet-grabber{width:42px;height:5px;border-radius:999px;background:#d5dcda;margin:2px auto 10px}.sheet-head{display:flex;justify-content:space-between;align-items:center;position:sticky;top:-10px;background:var(--card);padding:6px 0 10px;z-index:3}.sheet-head h2{margin:0;font-size:19px}.form{display:grid;gap:12px}.field{display:grid;gap:6px}.field label{font-size:12px;font-weight:800;color:var(--muted)}.field input,.field select,.field textarea{width:100%;min-height:46px;border:1px solid var(--line);border-radius:12px;background:#fff;padding:10px 12px;color:var(--text);font-size:16px}.field textarea{min-height:88px;resize:vertical}.field input[type="time"],.field input[type="date"]{padding:8px 10px}.help{font-size:11px;color:var(--muted)}
.fullscreen{position:fixed;z-index:70;inset:0;background:var(--bg);overflow:auto;padding:calc(8px + env(safe-area-inset-top)) 10px calc(18px + env(safe-area-inset-bottom))}.fullbar{position:sticky;top:0;z-index:4;display:flex;justify-content:space-between;align-items:center;background:rgba(246,248,247,.96);backdrop-filter:blur(12px);padding:8px 2px 10px}.fullbar h2{margin:0;font-size:18px}.map-wrap{height:70vh;min-height:500px;border:1px solid var(--line);border-radius:18px;background:#fff;overflow:hidden;touch-action:none;position:relative}.map-wrap svg{width:100%;height:100%;display:block}.map-tools{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.node text{font-size:13px;font-weight:800;pointer-events:none}.node rect{rx:14;ry:14;stroke-width:2}.node.selected rect{stroke:var(--accent);stroke-width:4}
.search{position:relative}.search input{width:100%;min-height:48px;border:1px solid var(--line);border-radius:14px;padding:11px 14px 11px 42px;background:#fff;font-size:16px}.search:before{content:'⌕';position:absolute;left:15px;top:8px;font-size:24px;color:var(--muted)}.section-title{font-size:13px;font-weight:900;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin:18px 2px 8px}.empty{padding:18px;text-align:center;color:var(--muted);font-size:13px;border:1px dashed var(--line);border-radius:14px}.money{font-variant-numeric:tabular-nums}.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.stat{padding:12px;border:1px solid var(--line);border-radius:14px;background:#fbfcfb}.stat b{display:block;font-size:18px}.stat span{font-size:11px;color:var(--muted)}
.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.cal-head{font-size:10px;text-align:center;color:var(--muted);font-weight:800;padding:6px 0}.day{min-height:66px;border:1px solid var(--line);background:#fff;border-radius:12px;padding:6px;position:relative;overflow:hidden}.day.other{opacity:.35}.day.today{border-color:#9fcab3;background:#f5fbf7}.day.selected{outline:2px solid var(--accent)}.day-num{font-size:11px;font-weight:850}.cal-chip{font-size:9px;padding:3px 4px;border-radius:6px;background:var(--accent2);color:var(--accent);margin-top:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.workout-card{border:1px solid var(--line);border-radius:14px;padding:11px;background:#fff;margin-bottom:8px}.workout-card.selected{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent2)}.exercise{display:flex;justify-content:space-between;gap:8px;font-size:12px;padding:6px 0;border-bottom:1px dashed var(--line)}.exercise:last-child{border:0}.stage{border:1px solid var(--line);border-radius:14px;padding:10px;margin-bottom:8px}.stage-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.stage-items{margin-top:8px}.stage-item{display:grid;grid-template-columns:1fr auto;gap:8px;padding:8px 0;border-top:1px solid var(--line);font-size:12px}.stage-item select{max-width:125px;border:1px solid var(--line);border-radius:9px;padding:6px;background:#fff;font-size:11px}
.rank-list{display:grid;gap:7px}.rank{display:flex;justify-content:space-between;align-items:center;padding:12px;border:1px solid var(--line);border-radius:13px}.rank.current{border-color:#b5d7c4;background:var(--accent2)}.rank.locked{opacity:.58}.achievement{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
@media (max-width:420px){.view{padding-left:10px;padding-right:10px}.topbar{padding-left:12px;padding-right:12px}.grid2{grid-template-columns:1fr}.quick-grid{grid-template-columns:repeat(2,1fr)}.stat-grid{grid-template-columns:1fr 1fr}.card{padding:12px}.page-head h1{font-size:23px}.day{min-height:58px;padding:4px}.cal-chip{font-size:8px}}
@media (max-width:340px){.brand{font-size:14px}.tagline{display:none}.stat-grid{grid-template-columns:1fr}.calendar{gap:2px}.day{min-height:54px;border-radius:9px}.quick-grid{grid-template-columns:1fr 1fr}.fab{right:12px}}
body.dark{--bg:#111713;--card:#18201b;--text:#eef5f0;--muted:#a3afa8;--line:#2a352e;--accent:#65b88c;--accent2:#21392b;--shadow:none;color-scheme:dark}body.dark input,body.dark select,body.dark textarea,body.dark .day,body.dark .workout-card{background:#18201b;color:var(--text)}body.dark .topbar,body.dark .bottom-nav,body.dark .sheet,body.dark .fullbar{background:rgba(24,32,27,.96)}body.dark .quick,body.dark .stat{background:#151c18}
